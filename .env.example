# --- Server
PORT=3000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/real_estate?schema=public

# --- Auth
# Use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# --- Cloudinary (https://console.cloudinary.com → Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=real-estate

# --- Seed: first admin account (used by `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin12345
